-- Шаг 1. Нарушение ссылочной целостности данных
SET session_replication_role = 'replica';
INSERT INTO groups (faculty_code, group_number, max_people) VALUES (999, 'ГРУППА-99', 15);
SET session_replication_role = 'origin';

-- Шаг 2. Запрос с левосторонним соединением (LEFT JOIN)
SELECT 
    f.faculty_code,
    f.faculty_name,
    f.activity_type,
    g.group_number,
    g.max_people
FROM faculties f
LEFT JOIN groups g ON f.faculty_code = g.faculty_code;

-- Шаг 3. Запрос с правосторонним соединением (RIGHT JOIN)
SELECT 
    f.faculty_code,
    f.faculty_name,
    f.activity_type,
    g.group_number,
    g.max_people
FROM faculties f
RIGHT JOIN groups g ON f.faculty_code = g.faculty_code;

-- Шаг 4. Восстановление ссылочной целостности данных
DELETE FROM groups WHERE faculty_code = 999;
